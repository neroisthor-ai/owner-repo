# Crew settings. Copy this file to .env and fill in what you use; .env is git-ignored.
# After editing, run `npm run doctor`: it checks the key, every model id and the voice model, and says what to fix.

# ---- Which crew does the work -------------------------------------------------------------------------------------
# auto = Claude if an Anthropic key is set, else Gemini if a Gemini key is set, else the free offline rules
CREW_LLM=gemini

# ---- Gemini (Google AI Studio > Get API key) ---------------------------------------------------------------------
GEMINI_API_KEY=
# The three models and their jobs. Change an id here if Google renames one; `npm run doctor` lists what your key can use.
# reads notes, ranks takes, plays the test audience (thinking: low)
CREW_GEMINI_LITE=gemini-3.5-flash-lite
# builds takes, props and shots, repairs them (thinking: high)
CREW_GEMINI_FLASH=gemini-3.8-flash
# plans, debugs, reviews, lays out sets from pictures (thinking: high)
CREW_GEMINI_PRO=gemini-3.1-pro-preview
# Who does Pro's jobs. auto = Pro, switching to the Flash group if Google says Pro isn't on your key's tier;
# flash = always the Flash group (several Flash calls on high thinking, side by side, then a final Flash pass that
# checks them against each other); pro = always Pro. The free API tier has no Pro, so use flash there.
CREW_PRO_MODE=auto
# How many Flash calls answer each of Pro's jobs (2 to 6). More is steadier but uses more of your daily Flash quota.
CREW_FLASH_GROUP=3
# Voices for the dialogue
CREW_TTS=gemini
CREW_GEMINI_TTS=gemini-3.8-flash-tts
# Optional: pick Gemini voices per character, e.g. kiran=Puck,mum=Kore (otherwise chosen from each character's voice)
# CREW_GEMINI_VOICES=

# ---- Claude (optional, instead of Gemini) ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# ---- Hand-holding (optional) -------------------------------------------------------------------------------------
# How much each model is guided is set per skill from its ability (src/llm/capability.ts). Pin one if needed:
# free | guided | strict; skills: read rank plan patch review script prop3d motion voice vision
# CREW_GRIP_PATCH=free

# ---- Storage -----------------------------------------------------------------------------------------------------
# Where a show's files live. Only "fs" works today.
CREW_STORAGE=fs
# Supabase: not used yet (see docs/STORAGE.md)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
