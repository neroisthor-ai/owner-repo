# [The Bob] A UWC boarding room, 4.4 x 4 m: two beds under mosquito nets, a barred
# window the moon throws its bars through, a tin trunk, a desk and the door.
# Beds run along z with the headboards at the back wall. Dressing has no stand mark;
# the anchors are where people stand, sit and sleep.
set boarding_room size 4.4 4 entrance door
  anchor door at -0.9 1.7 face 180
  anchor bed_a_side at -0.75 0.0 face 270 is none
  anchor bed_b_side at 0.75 0.0 face 90 is none
  anchor window_sill at 0 -1.1 face 180 is none
  anchor desk_seat at 1.3 1.5 face 90 is chair_wood
  anchor foot_a at -1.5 1.6 face 0 is none
  dress bed_boarding at -1.5 -0.65
  dress bed_boarding at 1.5 -0.65
  dress mosquito_net at -1.5 -0.65
  dress mosquito_net at 1.5 -0.65
  dress window_barred at 0 -1.94
  dress bedside_table at 0 -1.72
  dress bedside_lamp at 0.2 -1.72 height 0.75
  dress tin_trunk at -1.5 1.05
  dress school_desk at 1.85 1.55 face 270
  dress kanga at -2.17 0.5 face 90
  dress poster at 2.17 -0.7 face 270
  prop lamp at 0.2 -1.72 height 0.75 is bedside_lamp
