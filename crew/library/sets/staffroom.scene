# [The Bob] The staffroom, 6 x 4.5 m: an oak table, two armchairs, a kettle on the
# counter, a clock and a ceiling fan.
set staffroom size 6 4.5 entrance door
  anchor door at 2.4 1.85 face 180
  anchor chair_n at 0 -0.95 face 0 is chair_wood
  anchor chair_w at -1.15 -0.2 face 90 is chair_wood
  anchor chair_e at 1.15 -0.2 face 270 is chair_wood
  anchor armchair_l at -2.2 1.0 face 60 is armchair
  anchor armchair_r at 2.2 1.0 face 300 is armchair
  anchor kettle_spot at 1.9 -1.3 face 180 is none
  dress library_table at 0 -0.2
  dress coffee_table at 0 1.3
  dress kitchen_counter at 1.9 -1.92
  dress kettle at 1.9 -1.92 height 0.92
  dress bookshelf at -1.7 -2.05
  dress wall_clock at 0.4 -2.24
  dress ceiling_fan at 0 -0.2
  dress window_barred at -2.94 -0.8 face 90
  dress poster at 1.0 -2.24
  dress newspaper at 0 1.3 height 0.44
  prop mug at 0.35 -0.35 height 0.775
  prop mug_b at -0.4 -0.1 height 0.775 is mug
